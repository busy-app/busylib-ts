{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "src/*": ["src/*"],
      "BusyBar/*": ["src/BusyBar/*"],
      "ScreenStream/*": ["src/ScreenStream/*"],
      "StateStream/*": ["src/StateStream/*"],
      "ScreenRenderer/*": ["src/ScreenRenderer/*"],
      "Input/*": ["src/Input/*"],
      "Global/*": ["src/Global/*"],
      "Utils/*": ["src/Utils/*"]
    },

    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // Resolves the package.json `imports` map (`#font-maps`) under bundler resolution.
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationDir": "dist/types",
    "emitDeclarationOnly": true,

    "lib": ["ES2020", "DOM", "DOM.Iterable", "WebWorker"],
    "resolveJsonModule": true,

    // Fields become assignments in the constructor: dist carries no ES2022 field declarations, which an app built for es2020 would turn into _defineProperty helpers.
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "noEmit": false,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src", "tests", "env.d.ts", "tools/busybar/BusyBar.template.ts", "vite.config.ts", "vitest.config.ts", "vite-plugins"]
}
